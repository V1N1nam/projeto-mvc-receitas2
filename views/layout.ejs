<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title><%= typeof title !== 'undefined' ? title + ' | Receitas.io' : 'Receitas.io' %></title>
</head>
<body>
    <header class="navbar">
        <div class="container nav-container">
            <a href="/" class="logo">Receitas.io</a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/receitas">Receitas</a></li>
                    <li><a href="/sobre">Sobre</a></li>
                    <li><a href="/contato">Contato</a></li>
                    
                    <% if (isAuthenticated) { %>
                        <li><a href="/dashboard">Painel</a></li>
                        <li><a href="/estoque">Estoque</a></li>
                        <li><a href="/receitas/novo">Nova+</a></li>
                        <li><a href="/logout">Sair (<%= userName %>)</a></li>
                    <% } else { %>
                        <li><a href="/login">Login</a></li>
                        <li><a href="/cadastro">Registo</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>

    <main class="container page-content">
        
        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length > 0) { %>
            <div class="alert alert-success">
                <%= successMessage[0] %>
            </div>
        <% } %>
        
        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length > 0) { %>
            <div class="alert alert-danger">
                <%= errorMessage[0] %>
            </div>
        <% } %>

        <%- body %>
    </main>

    <footer class="footer">
        <div class="container">
            <div style="margin-bottom: 10px;">
                <a href="/sobre" style="color: #ccc; margin: 0 10px; text-decoration: none;">Sobre Nós</a>
                <a href="/contato" style="color: #ccc; margin: 0 10px; text-decoration: none;">Contato</a>
                <a href="/trabalhe" style="color: #ccc; margin: 0 10px; text-decoration: none;">Trabalhe Conosco</a>
            </div>
            <p>&copy; <%= new Date().getFullYear() %> Receitas.io. Todos os direitos reservados.</p>
        </div>
    </footer>
    
</body>
</html>